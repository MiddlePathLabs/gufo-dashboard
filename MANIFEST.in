include CONTRIBUTING.md SECURITY.md requirements.txt uv.lock
include .env.example .gitignore .dockerignore Dockerfile docker-compose.yml
recursive-include docs *.md
recursive-include tests *.py *.json *.sse *.txt *.md
recursive-include scripts *.py
recursive-exclude * __pycache__ *.pyc

# Exclude unreviewed local images, including entries in cached manifests.
prune docs/images

include docs/images/dashboard-demo.jpg docs/images/content-demo.jpg
