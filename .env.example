# Where Gufo listens (host networking: Gufo's published port on this host)
GUFO_BASE_URL=http://127.0.0.1:8080
# Only used for the dashboard's own /ready, /v1/models, /metrics polling.
# Never added to proxied client requests.
GUFO_API_KEY=
DATABASE_PATH=/data/gufo-dashboard.sqlite
DASHBOARD_PORT=8081
DASHBOARD_HOST=0.0.0.0
# Exact named hosts allowed in requests; IP literals are always accepted.
# Add your LAN hostname or authenticated gateway hostname if used.
DASHBOARD_ALLOWED_HOSTS=localhost
RETENTION_DAYS=90
POLL_INTERVAL_SECONDS=5
UPSTREAM_CONNECT_TIMEOUT=10
# empty = no read timeout (long prefills can take minutes)
UPSTREAM_READ_TIMEOUT=
STATS_QUEUE_SIZE=10000
SHUTDOWN_DRAIN_TIMEOUT=5
UNATTRIBUTED_THRESHOLD=64

# Opt-in local audit: latest user text and visible answer only. No images/files.
# Edit .env beside docker-compose.yml, then recreate the container to apply.
# CAPTURE_CONTENT=false stops new capture; it does not delete saved text.
CAPTURE_CONTENT=false
# Positive integer days; metrics have their own RETENTION_DAYS window.
CONTENT_RETENTION_DAYS=7
# UTF-8 bytes per question/answer, from 1 to 1048576; saved text is truncated.
CONTENT_MAX_BYTES=65536

# Optional numeric snapshot from the host-side cache observer. No raw logs.
GUFO_CACHE_STATE_PATH=
